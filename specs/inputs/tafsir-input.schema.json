{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://islamic-core-content/specs/inputs/tafsir-input.schema.json",
  "title": "TafsirInputCollection",
  "description": "Validation schema for raw-inputs/qul/tafsir-{lang}-{slug}.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verse_keys",
      "text",
      "format"
    ],
    "properties": {
      "verse_keys": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^([1-9][0-9]*):([1-9][0-9]*)(?!\\n)$"
        }
      },
      "text": {
        "type": "string",
        "pattern": "\\S"
      },
      "format": {
        "type": "string",
        "enum": [
          "plain",
          "html"
        ]
      }
    }
  }
}
